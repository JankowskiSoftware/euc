{
  "name": "EUC Lynx S – analiza jazdy",
  "short_name": "EUC",
  "lang": "pl",
  "display": "standalone",
  "start_url": "./",
  "scope": "./",
  "background_color": "#0b1220",
  "theme_color": "#0b1220",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "text/csv",
            ".csv",
            "text/comma-separated-values",
            "application/octet-stream",
            "text/plain"
          ]
        }
      ]
    }
  }
}